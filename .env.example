# Скопируйте в .env в корне репозитория (рядом с docker-compose.yml).
# На VPS: cp .env.example .env && nano .env

# --- Docker Postgres (обязательно для docker compose) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=postgres123

# --- API (в контейнере DB_HOST=postgres) ---
PORT=3000
NODE_ENV=production
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change_me
DB_NAME=postgres123

JWT_ACCESS_SECRET=change_me_long_random
JWT_REFRESH_SECRET=change_me_long_random
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

GIGACHAT_API_KEY=
HF_TOKEN=

RAG_CHUNK_SIZE=500
RAG_TOP_P=3
KNOWLEDGE_BASE_PATH=./knowledge-base

CORS_ORIGIN=https://funeral-services.ru,https://www.funeral-services.ru

# true только при первом запуске, потом false
DB_SEED=false
