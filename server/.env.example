# Локальная разработка (npm run start:dev в server/).
# Для Docker используйте корневой .env.example → .env

PORT=3000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_USER=******
DB_PASSWORD=******
DB_NAME=******

JWT_ACCESS_SECRET=*****
JWT_REFRESH_SECRET=******

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

GIGACHAT_API_KEY=******

# HuggingFace токен (получить здесь: https://huggingface.co/settings/tokens)
HF_TOKEN=******

# Настройки RAG (можно оставить как есть)
RAG_CHUNK_SIZE=500
RAG_TOP_P=3
# Ниже порога похожести с базой знаний вопрос считается оффтопом (0–1)
RAG_MIN_RELEVANCE_SCORE=0.38
KNOWLEDGE_BASE_PATH=./knowledge-base